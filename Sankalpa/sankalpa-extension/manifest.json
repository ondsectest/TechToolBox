{
  "manifest_version": 3,
  "name": "Sankalpa — Form Testing",
  "short_name": "Sankalpa",
  "key": "",
  "version": "0.6.3",
  "description": "Tests web forms: first-field focus, length limits, emoji counting, and whether the server enforces the same rules as the browser.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": [
    "debugger"
  ]
}
