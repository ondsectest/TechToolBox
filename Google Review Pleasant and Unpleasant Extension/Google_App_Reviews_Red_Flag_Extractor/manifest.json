{
  "manifest_version": 3,
  "name": "Review Red Flags",
  "version": "1.3.0",
  "description": "Finds angry or unpleasant words in Google Play reviews, loads all reviews for you, and exports an HTML dashboard report. Built by Santhosh Tuppad.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Review Red Flags",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.google.com/*"],
      "js": ["words.js", "modal-css.js", "loader.js", "report.js", "content.js"],
      "css": ["page.css"],
      "run_at": "document_idle"
    }
  ]
}
